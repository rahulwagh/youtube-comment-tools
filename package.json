  "keywords": ["youtube", "youtube-api", "youtube-data-api", "youtube-comments", "comments", "quota", "csv-export", "creator-tools", "cli"],
  "homepage": "https://replydial.com",
  "repository": { "type": "git", "url": "git+https://github.com/rahulwagh/youtube-comment-tools.git" },
  "bugs": { "url": "https://github.com/rahulwagh/youtube-comment-tools/issues" },
  "license": "MIT",
  "author": "Rahul Wagh (https://www.youtube.com/@RahulWagh)",
  "type": "module",
  "bin": { "yt-comments": "bin/yt-comments.mjs" },
  "exports": {
    ".": "./src/index.mjs",
    "./quota": "./src/quota.mjs"
  },
  "files": ["bin", "src", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test",
    "start": "node bin/yt-comments.mjs"
  }
